<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark, title-less window in the app's background colour, so there is no white flash on start -->
    <style name="Theme.Pb" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">#7EA6FF</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>
</resources>
