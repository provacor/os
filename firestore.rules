rules_version = '2';

// Provacor weekly leaderboard.
// weeks/{week}/users/{uid}: week is the Saturday date (YYYY-MM-DD) the week starts on.
// Everyone can read the board; a device can only write its own row, only the
// fields { name, seconds, updatedAt }, and its time can't grow faster than real time.
service cloud.firestore {
  match /databases/{database}/documents {
    match /weeks/{week}/users/{uid} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['name', 'seconds', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && validName(request.resource.data.name)
        && request.resource.data.seconds is int
        && request.resource.data.seconds >= 0
        // no more time than has passed since the week began (+1 day for time zones)
        && request.resource.data.seconds <= sinceWeekStart(week) + 86400
        // and an update can add at most the real time since the last write (+5 min slack)
        && (resource == null
            || request.resource.data.seconds <= resource.data.seconds
               + (request.time.toMillis() - resource.data.updatedAt.toMillis()) / 1000 + 300);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }

  function validName(n) {
    return n == null || (n is string && n.size() > 0 && n.size() <= 40);
  }

  function sinceWeekStart(week) {
    let p = week.split('-');
    return (request.time.toMillis() - timestamp.date(int(p[0]), int(p[1]), int(p[2])).toMillis()) / 1000;
  }
}
